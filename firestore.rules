rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// EchoLima Firestore Security Rules
//
// HISTORIK:
//   23. maj 2026 v1 — Architecture-WS security cleanup. KUN events-regel.
//                     → BLOKKEDE alt andet (default-deny på rules_version='2').
//                     → Android-klient mistede adgang til notes/contacts/tags/user-doc.
//   23. maj 2026 v2 — Emergency rollback: permissiv fallback for authenticated
//                     users + bevarer events-constraint. Restorer service.
//                     Skal erstattes af eksplicitte per-collection rules i V1.1.
//
// AKTUEL POLICY (v2 — midlertidig):
//   - Alle authenticated users kan læse/skrive ALT (matcher pre-23-maj-state)
//   - Events-collection har strikt anti-spoofing rule (uid + felt-validering)
//   - Update/delete på events er forbudt (immutable)
//
// NÆSTE SKRIDT (V1.1):
//   Skriv eksplicitte rules for hver collection:
//   - users/{uid}/...           → only owner
//   - users/{uid}/notes/{id}    → only owner
//   - users/{uid}/contacts/{id} → only owner
//   - users/{uid}/tags/{id}     → only owner
//   - notes/{id} (hvis root)    → check ownerUid felt
//   - niches/{id}, apps/{id},
//     tiers/{id}                → read-only for auth, write backend-only
//   - contact_requests/{id}     → write open, read backend-only
//   - feedback/{id}             → write open, read backend-only
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Events-collection (strikt — anti-spoofing) ───
    // Sikkerheds-mæssigt vigtigste collection: telemetri + AI-events der
    // bruges til billing/usage-tracking. Strikt validering på create.
    // Backend skriver via Admin SDK (bypasser rules). Klient må kun skrive
    // egne events med korrekt skema.
    match /events/{eventId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'type', 'timestamp'])
        && request.resource.data.type is string
        && request.resource.data.timestamp is number
        && request.resource.size() < 5000;
      allow update, delete: if false;
    }

    // ─── MIDLERTIDIG FALLBACK: alle authenticated users kan læse/skrive ───
    // Skal erstattes af eksplicitte per-collection rules i V1.1.
    // Denne regel matcher kun docs der IKKE allerede er dækket af mere
    // specifikke regler (Firestore evaluerer specifik-først; events får
    // sin egen behandling fordi /events/{eventId} er mere specifik end
    // wildcard).
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
